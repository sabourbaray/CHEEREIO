#!/bin/bash
#SBATCH -n 1                # Number of cores
#SBATCH -N 1                # Ensure that all cores are on one machine
#SBATCH -t 0-12:00          # Runtime in D-HH:MM, minimum of 10 minutes
#SBATCH -p huce_intel  # Partition to submit to
#SBATCH --mem=8000         # Memory pool for all cores (see also --mem-per-cpu)
#SBATCH -o prep_%j.out    # File to which STDOUT will be written, %j inserts jobid       
#SBATCH -e prep_%j.err    # File to which STDERR will be written, %j inserts jobid

source ../core/load_environment.sh || exit 1
source ../core/scheduler.sh || exit 1
if [[ $Scheduler == PBS && -z ${PBS_JOBID:-} ]]; then
  submit_job -W "$0"
  exit $?
fi

bash ../core/run_python.sh $(jq -r ".CondaEnv" ../ens_config.json) -u postprocess_workflow.py "histprocess" >> postprocess_prep_out.txt

bash ../core/run_python.sh $(jq -r ".AnimationEnv" ../ens_config.json) bigy_plots.py >> stats_out.txt
bash ../core/run_python.sh $(jq -r ".AnimationEnv" ../ens_config.json) animator.py
bash ../core/run_python.sh $(jq -r ".AnimationEnv" ../ens_config.json) bigy_animator.py
