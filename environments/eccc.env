# ORDENV and the GEOS-Chem stack are loaded by ECCC job startup.
source "$HOME/.startmamba_imi" || return 1
export CHEEREIO_ENV_NAME=${CHEEREIO_ENV_NAME:-cheereio-eccc}
conda activate "$CHEEREIO_ENV_NAME" || return 1
export CHEEREIO_PYTHON=$(python -c 'import sys; print(sys.executable)')
export OMP_STACKSIZE=500m
ulimit -s unlimited
