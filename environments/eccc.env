# Source from a shell with the working ECCC GEOS-Chem compiler/NetCDF stack.
# Optionally make that stack reproducible with an existing site environment file.
if [[ -n ${ECCC_GC_ENV:-} ]]; then
    source "$ECCC_GC_ENV" || return 1
fi
source "$HOME/.startmamba_imi" || return 1
eval "$(conda shell.bash hook)"
conda activate cheereio-eccc || return 1
export OMP_STACKSIZE=500m
ulimit -s unlimited
